# ── Database ────────────────────────────────
DB_USER=cbt_user
DB_PASSWORD=ganti_dengan_password_kuat
DB_NAME=cbt_db

# ── Keamanan ─────────────────────────────────
# Generate dengan: openssl rand -hex 32
JWT_SECRET=

# ── Aplikasi ─────────────────────────────────
APP_PORT=80
TZ=Asia/Jakarta

# ── Backup Data ──────────────────────────────
# Backup otomatis harian (database + gambar soal), dikelola di menu Sistem > Backup Data.
BACKUP_AUTO=true
# Jam mulai backup otomatis (0-23, waktu server)
BACKUP_HOUR=1
# Jumlah backup yang disimpan per jenis (otomatis / manual)
BACKUP_KEEP=14
